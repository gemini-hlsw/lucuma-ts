{
  "extends": ["@tsconfig/strictest/tsconfig.json", "@tsconfig/vite-react/tsconfig.json"],
  "compilerOptions": {
    "paths": {
      "@gql/*": ["./src/gql/*"],
      "@/*": ["./src/*"]
    },
    "lib": ["ES2025", "DOM"],
    "types": ["vite/client", "vitest/globals", "vitest", "@vitest/browser-playwright"],
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "exactOptionalPropertyTypes": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "comment": "mock-server is included so tests can typecheck the shared mock core; server.ts is node-only and typechecked by tsconfig.node.json.",
  "include": ["src", "mock-server"],
  "exclude": ["mock-server/server.ts"]
}
