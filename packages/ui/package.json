{
  "name": "@gemini-hlsw/navigate-ui",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gemini-hlsw/navigate-ts.git",
    "directory": "packages/ui"
  },
  "scripts": {
    "dev": "vite",
    "codegen:watch": "graphql-codegen --config tasks/codegen.ts --watch 'src/gql/**/*.ts' --watch '../configs/src/graphql/*.graphql'",
    "prebuild": "pnpm run codegen",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint:eslint": "eslint .",
    "codegen": "graphql-codegen --config tasks/codegen.ts"
  },
  "devDependencies": {
    "@apollo/client": "4.2.12",
    "@eslint/js": "10.0.1",
    "@fortawesome/fontawesome-svg-core": "7.3.1",
    "@fortawesome/pro-regular-svg-icons": "7.3.1",
    "@fortawesome/react-fontawesome": "3.5.0",
    "@gemini-hlsw/lucuma-common-ui": "workspace:*",
    "@gemini-hlsw/lucuma-core": "0.235.1",
    "@gemini-hlsw/lucuma-apps-schemas": "0.177.2-20260813-fa975554",
    "@gemini-hlsw/lucuma-odb-schemas": "0.95.0-8cc950a",
    "@gemini-hlsw/lucuma-ui-css": "0.176.0",
    "@gemini-hlsw/navigate-configs": "workspace:*",
    "@graphql-codegen/cli": "7.3.1",
    "@graphql-codegen/client-preset": "6.1.3",
    "@graphql-eslint/eslint-plugin": "4.4.1",
    "@graphql-typed-document-node/core": "3.2.0",
    "@rolldown/plugin-babel": "0.2.3",
    "@tailwindcss/vite": "4.3.3",
    "@tsconfig/strictest": "2.0.8",
    "@tsconfig/vite-react": "8.1.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/browser-playwright": "4.1.11",
    "@xyflow/react": "12.11.5",
    "babel-plugin-react-compiler": "1.0.0",
    "date-fns": "4.4.0",
    "eslint": "10.9.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.11.0",
    "graphql": "16.14.2",
    "graphql-ws": "6.2.1",
    "jotai": "2.20.2",
    "playwright": "1.62.1",
    "primereact": "10.9.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "sass": "1.103.1",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vite-plugin-mkcert": "2.1.0",
    "vitest": "4.1.11",
    "vitest-browser-react": "2.2.0"
  },
  "bundlemon": {
    "baseDir": "./dist",
    "pathLabels": {
      "hash": "[a-zA-Z0-9\\-_]+"
    },
    "files": [
      {
        "path": "assets/*-<hash>.{js,css}"
      }
    ],
    "reportOutput": [
      "github"
    ]
  }
}
