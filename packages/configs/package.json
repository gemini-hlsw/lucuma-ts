{
  "name": "@gemini-hlsw/navigate-configs",
  "version": "1.0.0",
  "main": "dist/index.js",
  "license": "BSD-3-Clause",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gemini-hlsw/navigate-ts.git",
    "directory": "packages/configs"
  },
  "exports": {
    ".": "./dist/index.js",
    "./db": "./dist/prisma/db.js"
  },
  "scripts": {
    "test": "vitest run",
    "generate": "prisma generate",
    "prebuild": "pnpm generate && pnpm codegen",
    "build": "tsc -b",
    "start": "pnpm build && pnpm preview",
    "preview": "node --enable-source-maps ./dist/index.js",
    "dev": "node --conditions=development --env-file=.env --watch --enable-source-maps ./src/index.ts",
    "codegen": "graphql-codegen --config tasks/codegen.ts",
    "codegen:watch": "pnpm codegen --watch 'src/graphql/**/*.ts' --watch 'src/graphql/*.graphql'",
    "lint:eslint": "eslint .",
    "production": "pnpm prisma migrate deploy && pnpm prisma db seed && pnpm preview"
  },
  "dependencies": {
    "@gemini-hlsw/lucuma-core": "0.239.1",
    "@gemini-hlsw/lucuma-apps-schemas": "0.177.2-20260813-fa975554",
    "@gemini-hlsw/lucuma-odb-schemas": "0.95.1-42.137bfdf",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "graphql": "17.0.2",
    "graphql-parse-resolve-info": "4.14.1",
    "graphql-scalars": "1.26.0",
    "graphql-yoga": "5.22.0",
    "prisma": "7.9.1"
  },
  "devDependencies": {
    "@eddeee888/gcg-typescript-resolver-files": "0.18.4",
    "@eslint/js": "10.0.1",
    "@graphql-codegen/cli": "7.3.1",
    "@graphql-eslint/eslint-plugin": "4.4.1",
    "@testcontainers/postgresql": "12.1.0",
    "@tsconfig/strictest": "2.0.8",
    "eslint": "10.9.1",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.11.0",
    "@vitest/eslint-plugin": "1.6.27",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  },
  "files": [
    "dist",
    "prisma",
    "src",
    "tasks",
    "gen",
    "prisma.config.ts"
  ]
}
